LEETCODE 1672

class Solution {
    public int maximumWealth(int[][] accounts) {
        int rich = 0;
        for (int[] i : accounts) {
            int sum = 0;
            for (int money : i) {
                sum += money;
            }
            rich = Math.max(rich, sum);
        }
        return rich;
    }
}  

LEETCODE 1572

class Solution {

    public int diagonalSum(int[][] mat) {

        int n = mat.length;
        int sum = 0;

        for (int i = 0; i < n; i++) {

            sum = sum + mat[i][i];

            if (i != n - 1 - i) {
                sum = sum + mat[i][n - 1 - i];
            }
        }
        return sum;
    }

